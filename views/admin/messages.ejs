<%- include('../partials/header') %>
<%- include('../partials/navbar') %>
<%- include('../partials/flash') %>

<div class="admin-layout">
  <aside class="admin-sidebar">
    <div style="font-weight: 700; color: var(--golden-yellow); font-size: 0.9rem; margin-bottom: 20px; text-transform: uppercase;">ADMIN CONTROL CENTER</div>
    <ul class="admin-menu">
      <li class="admin-menu-item"><a href="/admin" class="admin-menu-link">📊 Dashboard Overview</a></li>
      <li class="admin-menu-item"><a href="/admin/registrations" class="admin-menu-link">📑 Course Registrations</a></li>
      <li class="admin-menu-item"><a href="/admin/projects" class="admin-menu-link">🛠️ Internal Projects</a></li>
      <li class="admin-menu-item"><a href="/admin/messages" class="admin-menu-link active">💬 Contact Messages</a></li>
    </ul>
  </aside>

  <main class="admin-main">
    <div class="admin-header">
      <div>
        <h2>CONTACT INQUIRIES & <span class="text-gold">MESSAGES</span></h2>
        <p style="color: var(--text-grey);">Messages sent by users via the website contact form.</p>
      </div>
    </div>

    <div style="display: flex; flex-direction: column; gap: 20px;">
      <% if (messages.length === 0) { %>
        <div style="background: var(--dark-charcoal); padding: 40px; border-radius: var(--radius-md); text-align: center; color: var(--text-grey);">
          No contact messages received yet.
        </div>
      <% } else { %>
        <% messages.forEach(msg => { %>
          <div style="background: var(--card-bg); border: 1px solid <%= msg.status === 'unread' ? 'var(--border-color)' : 'var(--border-subtle)' %>; padding: 24px; border-radius: var(--radius-md);">
            <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 12px; flex-wrap: wrap; gap: 10px;">
              <div>
                <h4 style="color: var(--text-white); font-size: 1.2rem;"><%= msg.name %></h4>
                <div style="color: var(--golden-yellow); font-size: 0.9rem;">Subject: <%= msg.subject %></div>
                <small style="color: var(--text-grey);">Email: <%= msg.email %> | Phone: <%= msg.phone || 'N/A' %></small>
              </div>
              <div style="display: flex; align-items: center; gap: 10px;">
                <span class="badge-status <%= msg.status === 'unread' ? 'badge-pending' : 'badge-approved' %>"><%= msg.status.toUpperCase() %></span>
                <small style="color: var(--text-grey);"><%= new Date(msg.createdAt).toLocaleString() %></small>
              </div>
            </div>

            <p style="color: var(--text-grey); background: var(--primary-black); padding: 16px; border-radius: var(--radius-sm); border: 1px solid var(--border-subtle); margin-bottom: 14px; white-space: pre-line;">
              <%= msg.message %>
            </p>

            <% if (msg.status === 'unread') { %>
              <form action="/admin/messages/<%= msg._id %>/read" method="POST">
                <button type="submit" class="btn btn-outline btn-sm">Mark as Read</button>
              </form>
            <% } %>
          </div>
        <% }) %>
      <% } %>
    </div>

  </main>
</div>

<%- include('../partials/footer') %>
