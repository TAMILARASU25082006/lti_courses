<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<section class="section" style="padding-top: 60px;">
  <div class="container" style="max-width: 750px; text-align: center;">
    <div style="background: var(--dark-charcoal); border: 1px solid var(--border-color); border-radius: var(--radius-lg); padding: 50px;">
      <div style="font-size: 4rem; color: var(--golden-yellow); margin-bottom: 10px;">🎉</div>
      <h2 style="font-size: 2.2rem; color: var(--text-white); margin-bottom: 14px;">REGISTRATION SUBMITTED SUCCESSFULLY!</h2>
      <p style="color: var(--text-grey); font-size: 1.05rem; margin-bottom: 30px;">
        Thank you, <strong><%= registration.fullName %></strong>. Your registration for <strong class="text-gold"><%= registration.selectedCourse %></strong> has been securely logged into LTI Ed-Tech portal.
      </p>

      <div style="background: var(--primary-black); border: 1px solid var(--border-subtle); padding: 24px; border-radius: var(--radius-md); text-align: left; margin-bottom: 30px;">
        <h4 style="color: var(--golden-yellow); border-bottom: 1px solid var(--border-subtle); padding-bottom: 8px; margin-bottom: 14px;">REGISTRATION SUMMARY DETAILS:</h4>
        <p style="margin-bottom: 6px;"><strong>Registration Reference ID:</strong> <span class="text-gold">LTI-REG-<%= registration._id.toString().substring(18) %></span></p>
        <p style="margin-bottom: 6px;"><strong>Email:</strong> <%= registration.email %></p>
        <p style="margin-bottom: 6px;"><strong>Mobile:</strong> +91 <%= registration.mobile %></p>
        <p style="margin-bottom: 6px;"><strong>Course:</strong> <%= registration.selectedCourse %></p>
        <% if (registration.roboticsLevel && registration.roboticsLevel !== 'N/A') { %>
          <p style="margin-bottom: 6px;"><strong>Robotics Level:</strong> <%= registration.roboticsLevel %></p>
        <% } %>
        <p style="margin-bottom: 6px;"><strong>Learning Mode:</strong> <%= registration.preferredMode %></p>
        <p style="margin-bottom: 6px;"><strong>Current Status:</strong> <span class="badge badge-pending">PENDING APPROVAL</span></p>
      </div>

      <p style="color: var(--text-grey); font-size: 0.95rem; margin-bottom: 24px;">Our admissions team will reach out via mobile/email soon. If you have created a student account, you can monitor your status inside your Student Dashboard.</p>

      <div style="display: flex; justify-content: center; gap: 16px;">
        <a href="/" class="btn btn-outline">Back to Home</a>
        <% if (!currentUser) { %>
          <a href="/signup" class="btn btn-gold">Create Account to Track Status →</a>
        <% } else { %>
          <a href="/profile" class="btn btn-gold">Go to My Dashboard →</a>
        <% } %>
      </div>
    </div>
  </div>
</section>

<%- include('../partials/footer') %>
