<%- include('../partials/header') %>
<%- include('../partials/navbar') %>
<%- include('../partials/flash') %>

<section class="section py-16">
  <div class="container mx-auto px-4 max-w-lg">
    <div class="bg-darkCharcoal border border-yellow-500/20 rounded-2xl p-8 shadow-2xl">
      <div class="text-center mb-6">
        <div class="badge mb-2">STUDENT PORTAL</div>
        <h2 class="text-3xl font-extrabold text-white">CREATE STUDENT ACCOUNT</h2>
        <p class="text-textGrey text-sm mt-1">Sign up quickly with Google or fill out registration details below</p>
      </div>

      <!-- GOOGLE OAUTH SIGNUP BUTTON -->
      <a href="/auth/google" class="w-full flex items-center justify-center gap-3 bg-white text-gray-800 font-semibold py-3 px-4 rounded-xl hover:bg-gray-100 transition duration-200 shadow-md mb-6">
        <svg class="w-5 h-5" viewBox="0 0 24 24">
          <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
          <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
          <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
          <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
        </svg>
        <span>Continue with Google</span>
      </a>

      <!-- DIVIDER -->
      <div class="relative flex py-2 items-center mb-6">
        <div class="flex-grow border-t border-gray-700"></div>
        <span class="flex-shrink mx-4 text-gray-400 text-xs uppercase tracking-wider">Or register with Email</span>
        <div class="flex-grow border-t border-gray-700"></div>
      </div>

      <!-- NORMAL SIGNUP FORM -->
      <form action="/signup" method="POST">
        <div class="form-group">
          <label class="form-label" for="signupName">Full Name <span class="text-gold">*</span></label>
          <input type="text" id="signupName" name="fullName" class="form-control" placeholder="Enter your name" value="<%= typeof formData !== 'undefined' ? formData.fullName : '' %>" required>
        </div>

        <div class="form-group">
          <label class="form-label" for="signupEmail">Email Address <span class="text-gold">*</span></label>
          <input type="email" id="signupEmail" name="email" class="form-control" placeholder="example@domain.com" value="<%= typeof formData !== 'undefined' ? formData.email : '' %>" required>
        </div>

        <div class="form-group">
          <label class="form-label" for="signupPassword">Password (Min 6 characters) <span class="text-gold">*</span></label>
          <div class="relative flex items-center">
            <input type="password" id="signupPassword" name="password" class="form-control pr-12" placeholder="Create a secure password" minlength="6" required>
            <button type="button" id="toggleSignupPass" onclick="togglePassword('signupPassword', 'toggleSignupPass')" class="absolute right-3 focus:outline-none p-1 text-goldenYellow hover:scale-110 transition" title="Toggle password visibility">
              <svg class="w-6 h-6 text-goldenYellow" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
              </svg>
            </button>
          </div>
          <div class="flex items-center gap-2 mt-2">
            <input type="checkbox" id="showSignupPassCheckbox" onclick="togglePassword('signupPassword', 'toggleSignupPass')" class="rounded border-gray-700 text-goldenYellow focus:ring-goldenYellow cursor-pointer">
            <label for="showSignupPassCheckbox" class="text-xs text-textGrey cursor-pointer select-none">Show Password</label>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="form-group">
            <label class="form-label" for="signupMobile">Mobile Number</label>
            <input type="tel" id="signupMobile" name="mobile" class="form-control" placeholder="9342988487" value="<%= typeof formData !== 'undefined' ? formData.mobile : '' %>">
          </div>
          <div class="form-group">
            <label class="form-label" for="signupQualification">Qualification</label>
            <input type="text" id="signupQualification" name="qualification" class="form-control" placeholder="e.g. 10th, B.Tech" value="<%= typeof formData !== 'undefined' ? formData.qualification : '' %>">
          </div>
        </div>

        <div class="form-group">
          <label class="form-label" for="signupSchool">School / College Name</label>
          <input type="text" id="signupSchool" name="schoolCollege" class="form-control" placeholder="Your institution" value="<%= typeof formData !== 'undefined' ? formData.schoolCollege : '' %>">
        </div>

        <!-- Optional Admin Key for administrator setup -->
        <div class="form-group">
          <label class="form-label" for="adminKey">Admin Access Key <small class="text-textGrey font-normal">(Optional - For Administrators Only)</small></label>
          <div class="relative flex items-center">
            <input type="password" id="adminKey" name="adminKey" class="form-control pr-12" placeholder="Leave empty for Student account">
            <button type="button" id="toggleAdminKeyPass" onclick="togglePassword('adminKey', 'toggleAdminKeyPass')" class="absolute right-3 focus:outline-none p-1 text-goldenYellow hover:scale-110 transition" title="Toggle password visibility">
              <svg class="w-6 h-6 text-goldenYellow" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
              </svg>
            </button>
          </div>
        </div>

        <button type="submit" class="btn btn-gold w-full mt-2 py-3">Create Student Account →</button>
      </form>

      <div class="text-center mt-6 text-textGrey text-sm">
        Already have an account? <a href="/login" class="text-goldenYellow font-semibold hover:underline">Login here</a>
      </div>
    </div>
  </div>
</section>

<%- include('../partials/footer') %>
