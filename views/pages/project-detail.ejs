<%- include('../partials/header') %>
<%- include('../partials/navbar') %>
<%- include('../partials/flash') %>

<section class="section" style="padding-top: 60px;">
  <div class="container" style="max-width: 900px;">
    <div style="background: var(--dark-charcoal); border: 1px solid var(--border-color); border-radius: var(--radius-lg); padding: 40px;">
      <a href="/projects" class="text-gold" style="font-size: 0.9rem; font-weight: 600;">← Back to All Projects</a>

      <div class="badge" style="margin-top: 16px; margin-bottom: 12px;"><%= project.category %></div>
      <h1 style="font-size: 2.5rem; margin-bottom: 16px;"><%= project.title %></h1>
      
      <p style="color: var(--text-grey); font-size: 1.1rem; margin-bottom: 24px;"><%= project.description %></p>

      <div class="hero-image-wrapper" style="margin-bottom: 30px;">
        <img src="<%= project.image %>" alt="<%= project.title %>" style="width: 100%; max-height: 400px; object-fit: cover;">
      </div>

      <div style="margin-bottom: 30px;">
        <h4 style="color: var(--golden-yellow); font-size: 1.1rem; margin-bottom: 10px;">Technologies Used:</h4>
        <div style="display: flex; gap: 8px; flex-wrap: wrap;">
          <% project.technologies.forEach(tech => { %>
            <span style="font-size: 0.85rem; background: rgba(255,201,40,0.15); border: 1px solid var(--border-color); padding: 6px 14px; border-radius: 20px; color: var(--golden-yellow); font-weight: 600;"><%= tech %></span>
          <% }) %>
        </div>
      </div>

      <% if (project.category === 'Robotics Projects' || project.has3DModel) { %>
        <!-- INTERACTIVE 3D STUDENT ROBOT SHOWCASE -->
        <div style="background: linear-gradient(135deg, rgba(255,201,40,0.08), rgba(21,21,21,0.9)); border: 1px solid var(--border-color); border-radius: var(--radius-md); padding: 24px; margin-bottom: 30px;">
          <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; margin-bottom: 16px;">
            <div>
              <div class="badge" style="background: rgba(255,201,40,0.2); color: var(--golden-yellow);">🧊 INTERACTIVE 3D ROBOT CAD VIEW</div>
              <h3 style="font-size: 1.4rem; font-weight: 700; margin-top: 6px; color: var(--text-white);">Student 3D Robot CAD Inspector</h3>
            </div>
            <button onclick="openRobot3dModal({ modelType: '<%= project.model3DType || 'rover' %>', title: '<%= project.title %>', specs: <%= JSON.stringify(project.modelSpecs || {}) %> })" class="btn btn-gold btn-sm">
              🚀 Fullscreen 3D Inspector
            </button>
          </div>

          <p style="color: var(--text-grey); font-size: 0.95rem; margin-bottom: 20px;">
            Drag to rotate in 360°, scroll to zoom, or click components to inspect internal circuit boards, sensors, and chassis wiring designed by our student.
          </p>

          <div id="inlineProject3dCanvas" style="width: 100%; height: 380px; background: #0c0c0e; border-radius: var(--radius-md); border: 1px solid rgba(255,201,40,0.2); overflow: hidden; position: relative;"></div>

          <script src="/js/robot3dViewer.js"></script>
          <script>
            document.addEventListener('DOMContentLoaded', () => {
              new Robot3DViewer('inlineProject3dCanvas', {
                modelType: '<%= project.model3DType || 'rover' %>',
                autoRotate: true
              });
            });
          </script>
        </div>
      <% } %>

      <% if (project.detailedContent) { %>
        <div style="background: var(--primary-black); padding: 24px; border-radius: var(--radius-md); border: 1px solid var(--border-subtle);">
          <h4 style="color: var(--text-white); font-size: 1.2rem; margin-bottom: 12px;">Detailed Project Overview:</h4>
          <div style="color: var(--text-grey); line-height: 1.7; white-space: pre-line;"><%= project.detailedContent %></div>
        </div>
      <% } %>

    </div>
  </div>
</section>

<%- include('../partials/robot3dModal') %>
<%- include('../partials/footer') %>
