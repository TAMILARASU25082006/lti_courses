<%- include('../partials/header') %>
<%- include('../partials/navbar') %>
<%- include('../partials/flash') %>

<section class="section" style="padding-top: 60px;">
  <div class="container">
    <div class="section-header">
      <div class="badge">ABOUT LTI</div>
      <h2>LEARN TODAY. BUILD TOMORROW. <span class="text-gold">INNOVATE BEYOND.</span></h2>
      <p>LTI (Learn, Think & Innovate) is a pioneer in practical technology education, enabling students to bridge the gap between theoretical concepts and hands-on technological creation.</p>
    </div>

    <!-- MEANING OF LTI -->
    <div style="background: var(--dark-charcoal); border: 1px solid var(--border-color); border-radius: var(--radius-lg); padding: 40px; margin-bottom: 60px;">
      <h3 style="font-size: 1.8rem; color: var(--golden-yellow); margin-bottom: 20px; text-align: center;">WHAT DOES LTI STAND FOR?</h3>
      <div class="cards-grid">
        <div style="background: var(--primary-black); padding: 24px; border-radius: var(--radius-md); border: 1px solid var(--border-subtle);">
          <h4 style="font-size: 1.3rem; color: var(--text-white); margin-bottom: 10px;"><span class="text-gold">L</span> – LEARN</h4>
          <p style="color: var(--text-grey); font-size: 0.95rem;">Acquiring real-world technical fundamentals across hardware electronics, full-stack programming languages, and modern design frameworks.</p>
        </div>
        <div style="background: var(--primary-black); padding: 24px; border-radius: var(--radius-md); border: 1px solid var(--border-subtle);">
          <h4 style="font-size: 1.3rem; color: var(--text-white); margin-bottom: 10px;"><span class="text-gold">T</span> – THINK</h4>
          <p style="color: var(--text-grey); font-size: 0.95rem;">Fostering analytical logic, computational thinking, wireframe architecture, and circuit diagnostic problem-solving abilities.</p>
        </div>
        <div style="background: var(--primary-black); padding: 24px; border-radius: var(--radius-md); border: 1px solid var(--border-subtle);">
          <h4 style="font-size: 1.3rem; color: var(--text-white); margin-bottom: 10px;"><span class="text-gold">I</span> – INNOVATE</h4>
          <p style="color: var(--text-grey); font-size: 0.95rem;">Building working prototypes, autonomous robotics systems, production web applications, and personal creative portfolios.</p>
        </div>
      </div>
    </div>

    <!-- VISION & MISSION -->
    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 30px; margin-bottom: 60px;">
      <div class="card" style="border-color: var(--border-color);">
        <div class="badge" style="width: fit-content; margin-bottom: 12px;">OUR VISION</div>
        <h3 class="card-title text-gold">Empowering Technical Innovators</h3>
        <p class="card-text">To inspire and equip students with practical skills, fostering a generation of technical creators who don't just use technology—they build it.</p>
      </div>
      <div class="card" style="border-color: var(--border-color);">
        <div class="badge" style="width: fit-content; margin-bottom: 12px;">OUR MISSION</div>
        <h3 class="card-title text-gold">Hands-On Practical Excellence</h3>
        <p class="card-text">To deliver project-based education in Robotics, Web Development, and UI/UX Design that cultivates real engineering capabilities, critical reasoning, and product innovation.</p>
      </div>
    </div>

    <!-- TEACHING METHODOLOGY -->
    <div class="section-header">
      <div class="badge">OUR METHODOLOGY</div>
      <h2>OUR PRACTICAL <span class="text-gold">LEARNING APPROACH</span></h2>
    </div>

    <div class="cards-grid">
      <div class="card">
        <h4 style="color: var(--golden-yellow); font-size: 1.1rem; margin-bottom: 8px;">1. Project-Based Learning</h4>
        <p class="card-text">Students spend 80% of their time writing code, wiring breadboards, testing sensors, and designing interfaces rather than passive lecture watching.</p>
      </div>
      <div class="card">
        <h4 style="color: var(--golden-yellow); font-size: 1.1rem; margin-bottom: 8px;">2. Level Progression</h4>
        <p class="card-text">Structured module paths ensure beginners master fundamental electronic circuits and coding basics before building complex autonomous or full-stack systems.</p>
      </div>
      <div class="card">
        <h4 style="color: var(--golden-yellow); font-size: 1.1rem; margin-bottom: 8px;">3. Expert Mentorship</h4>
        <p class="card-text">Learn directly from experienced engineers and senior developers located at our Chennai training lab.</p>
      </div>
    </div>

    <!-- KEY ACHIEVEMENT -->
    <div class="achievement-banner" style="margin-top: 60px;">
      <div>
        <div class="badge">PROVEN MILESTONE</div>
        <h3 style="font-size: 1.8rem; margin: 10px 0; color: var(--text-white);">200+ Interns Trained in Full Stack Web Development</h3>
        <p style="color: var(--text-grey);">Over 200 interns have completed practical web development training with LTI, building real-world software applications and gaining deep full-stack mastery.</p>
      </div>
      <a href="/register" class="btn btn-gold" style="white-space: nowrap;">Register for Next Cohort</a>
    </div>

  </div>
</section>

<%- include('../partials/footer') %>
